# ── OCR Model ──────────────────────────────────────────────────────────────
# Path to your fine-tuned PaddleOCR model directory
# Leave as "models/" if your weights are in the models/ folder
MODEL_DIR=models/

# Set to "true" if you have a CUDA GPU available
USE_GPU=false

# ── LLM Providers ──────────────────────────────────────────────────────────
# Get a free Groq key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Get a free Gemini key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Notion Integration ─────────────────────────────────────────────────────
# Create an integration at: https://www.notion.so/my-integrations
# The token starts with "secret_"
NOTION_TOKEN=secret_your_token_here

# Open your target Notion page in browser. The URL looks like:
# https://www.notion.so/My-Page-Title-350e54104f86819aba08d4d2535ad4d0
# The last part (after the last dash) is the page ID:
NOTION_PARENT_PAGE_ID=350e54104f86819aba08d4d2535ad4d0
